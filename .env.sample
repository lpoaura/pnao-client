# PNAO auth settings
PNAO_BASE_URL=
PNAO_USERNAME=
PNAO_PASSWORD=

# PostgreSQL settings
# DATABASE_URL setting expect an uri: postgresql://user:password@host:port/database?application_name=pnao_client
# TLS is enforced by default (sslmode=require). For local development without
# TLS only, append ?sslmode=disable to the uri.
DATABASE_URL=
# Must be a plain SQL identifier (letters, digits, '_', starting with a letter
# or '_', max 63 chars) - it is validated at startup to prevent SQL injection.
PNAO_DB_SCHEMA=